[package]
name = "{{project-name}}"
version = "0.1.0"
edition = "2024"
rust-version = "1.99.1"
publish = false

[dependencies]
axum = { version = "0.8.9", features = ["macros"] }
serde = { version = "1", features = ["derive"] }
tokio = { version = "1", features = ["macros", "rt-multi-thread"] }
warded-server = { git = "https://github.com/viell-dev/slop-warded-server", tag = "0.1.0-alpha.3" }

[dev-dependencies]
http-body-util = "0.1"
serde_json = "1"
tower = { version = "0.5", features = ["util"] }
